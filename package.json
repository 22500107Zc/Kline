{
  "name": "kiln",
  "version": "0.1.0",
  "private": false,
  "description": "Kiln \u2014 an open source 3D modeling application. A browser-native alternative to Blender.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --port 4173 --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --log-level=warning && node --test '.test-build/*.test.js'"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "3d",
    "modelling",
    "modeling",
    "mesh",
    "webgl",
    "webgl2",
    "editor",
    "blender",
    "gltf",
    "subdivision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/22500107zc/yes.git"
  }
}
